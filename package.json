{
    "name": "playwright-e2e-tests",
    "version": "1.0.0",
    "description": "Playwright e2e tests with AI capabilities",
    "keywords": [
        "playwright",
        "playwright-e2e-tests"
    ],
    "license": "ISC",
    "author": "DanielT",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "test": "npx playwright test src/tests/eaWebApp",
        "test:nopCommerce": "npx playwright test src/tests/nopCommerce/ui/",
        "test:eaWebApp": "npx playwright test --headed src/tests/nopCommerce/ui/",
        "test:nopCommerce-be": "npx playwright test src/tests/nopCommerce/backend/",
        "lint": "eslint src/lib src/tests playwright.config.ts",
        "lint:fix": "eslint src/lib src/tests playwright.config.ts --fix",
        "report:pw": "npx playwright show-report reports/playwright-report",
        "report:allure": "allure serve reports/allure-results"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/node": "^25.0.10",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "allure-playwright": "^3.4.5",
        "chalk": "^5.6.2",
        "dotenv": "^17.2.3",
        "eslint": "^10.1.0",
        "eslint-plugin-playwright": "^2.10.1",
        "globals": "^17.4.0"
    },
    "dependencies": {
        "@playwright/cli": "^0.1.11",
        "tiny-invariant": "^1.3.3"
    }
}
