{
    "compilerOptions": {
        "target": "ESNext",
        "module": "CommonJS",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": false,
        "noImplicitAny": false
    },
    "include": [
        "src/tests/**/*.ts",
        "data/**/*.ts",
        "playwright.config.ts",
        "src/lib/helpers/logger.ts",
        "src/lib/helpers/file-helper.ts",
        "src/lib/global/global-teardown.ts",
        "src/lib/global/global-setup.ts",
        "src/lib/helpers/pw-helper.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
