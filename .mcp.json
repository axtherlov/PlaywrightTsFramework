{
    "mcpServers": {
        "playwright": {
            "command": "npx",
            "args": ["@playwright/mcp@latest"]
        },
        "playwright-test": {
            "type": "stdio",
            "command": "npx",
            "args": ["playwright", "run-test-mcp-server", "--headless"]
        },
        "browserstack": {
            "command": "npx",
            "args": ["-y", "@browserstack/mcp-server@latest"],
            "env": {}
        }
    }
}
