{
    "mcpServers": {
        "playwright": {
            "command": "npx",
            "args": ["@playwright/mcp@latest"]
        },
        "playwright-test": {
            "type": "stdio",
            "command": "npx",
            "args": ["playwright", "run-test-mcp-server", "--headless"]
        },
        "browserstack": {
            "command": "npx",
            "args": ["-y", "@browserstack/mcp-server@latest"],
            "env": {}
        },
        "azure-devops": {
            "command": "npx",
            "args": ["-y", "@tiberriver256/mcp-server-azure-devops"],
            "env": {
                "AZURE_DEVOPS_ORG_URL": "",
                "AZURE_DEVOPS_AUTH_METHOD": "",
                "AZURE_DEVOPS_PAT": ""
            }
        }
    }
}
